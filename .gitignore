.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
node_modules/
dist/
# 원본 촬영 데이터와 대용량 산출물은 저장소에 올리지 않는다
data/raw/
data/synth/
# 합성 데이터(v1 2.0GB, v2 2.4GB)는 scripts/make_seg_data.py 로 다시 만든다 (README 8절)
data/synth3d/
data/synth3d_v2/
data/synth3d*/
*.pt
# 학습한 가중치는 작아서(1MB 미만) 저장소에 둔다
!models/*.pt
!models/v1/*.pt
!models/exp/*.pt
.env
.env.*
vendor/
# 원본 영상 (용량이 크고 촬영자가 나온다)
*.mov
*.MOV
*.mp4
!reports/track_0.mp4
data/real/
!web/public/samples/*.mp4
# 개발 서버·라벨 서버 기록 (내 컴퓨터 경로가 들어간다)
reports/*.log
*.log

# 제출 묶음(PDF·ZIP)은 저장소에 올리지 않는다 (submission.json 은 올린다)
submission/
